# Ouster OS-1-128 (1024x10, ROS 2 driver) + Insta360 X4 front fisheye (1440x1440), Spot mount v2.
IMAGE_TOPIC=/camera_front
POINTS_TOPIC=/ouster/points
INFO_TOPIC=/camera_info_omnidir

LIDAR_TYPE=spinning

CAMERA_MODEL=omnidir                 # OpenCV omnidir (Mei); values from front_omnidir_intrinsics.json
CAMERA_INTRINSICS=687.344052,687.263911,728.273899,722.792744,0.752012
CAMERA_DISTORTION=-0.190037,0.020269,-0.000258,-0.001424

INITIAL_GUESS=superglue

VOXEL_RESOLUTION=0.008               # range quantisation of the Ouster ROS 2 driver point cloud
MIN_DISTANCE=
INTENSITY_CHANNEL=
SUPERGLUE_WEIGHTS=indoor
SUPERGLUE_EXTRA_ARGS="--sinkhorn_iterations 25"
RANSAC_ERROR_THRESH=6
ROBUST_KERNEL_WIDTH=6
