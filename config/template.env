# Sensor description (bash syntax), read by record_calib_bags.sh and calibrate_in_container.sh.
# Empty optional keys fall back to the toolbox defaults.

IMAGE_TOPIC=/camera/image_raw        # sensor_msgs/Image
POINTS_TOPIC=/points                 # sensor_msgs/PointCloud2
INFO_TOPIC=/camera/camera_info       # sensor_msgs/CameraInfo; may be empty when the intrinsics are given below

# spinning       : Ouster / Velodyne / Hesai ...  -> preprocess --dynamic_lidar_integration
# non_repetitive : Livox ...                      -> static accumulation (no flag)
LIDAR_TYPE=spinning

# auto (taken from CameraInfo, plumb_bob / fisheye only) | plumb_bob | fisheye | atan | omnidir | equirectangular
CAMERA_MODEL=auto
CAMERA_INTRINSICS=                   # fx,fy,cx,cy(,xi)   no spaces; required unless CAMERA_MODEL=auto
CAMERA_DISTORTION=                   # k1,k2,p1,p2(,k3)   no spaces; required unless CAMERA_MODEL=auto

# superglue (automatic; SuperGlue is licensed for non-commercial research only) | manual (pick point pairs in a GUI)
INITIAL_GUESS=superglue

# optional overrides
VOXEL_RESOLUTION=                    # preprocess --voxel_resolution (default 0.002)
MIN_DISTANCE=                        # preprocess --min_distance (default 1.0)
INTENSITY_CHANNEL=                   # preprocess --intensity_channel (default auto)
SUPERGLUE_WEIGHTS=                   # indoor | outdoor (default outdoor)
SUPERGLUE_EXTRA_ARGS=                # e.g. "--sinkhorn_iterations 25 --rotate_camera 90"
RANSAC_ERROR_THRESH=                 # initial_guess_auto --ransac_error_thresh (default 10 px)
ROBUST_KERNEL_WIDTH=                 # initial_guess_auto --robust_kernel_width (default 10 px)
